{
  "name": "companion-social",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "check": "npm run typecheck && npm run validate:openapi && npm run test:coverage",
    "test": "node --experimental-strip-types --test backend/test/*.test.ts",
    "test:postgres": "bash backend/scripts/test-postgres.sh",
    "test:coverage": "node --experimental-strip-types --test --experimental-test-coverage --test-coverage-lines=90 --test-coverage-functions=90 --test-coverage-branches=80 backend/test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "validate:openapi": "npx --yes @redocly/cli@1.27.2 lint contracts/openapi/v0.yaml --extends minimal",
    "dev:mobile:db:init": "node --experimental-strip-types backend/scripts/init-mobile-dev-db.ts",
    "dev:mobile:api": "node --experimental-strip-types backend/src/dev/mobile-http-server.ts",
    "test:mobile:residency": "node --experimental-strip-types backend/scripts/smoke-companion-residency.ts",
    "start:mobile:api": "node --experimental-strip-types backend/src/http/supabase-mobile-server.ts",
    "admin": "node --experimental-strip-types backend/scripts/admin-console.ts",
    "chat:try": "node --experimental-strip-types backend/scripts/chat-model-try.ts"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "@types/pg": "^8.23.1",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.6.0",
    "pg": "^8.23.0"
  }
}
