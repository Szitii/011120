{
  "name": "@companion-social/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "check": "npm run typecheck && npm test",
    "export:ci": "expo export --platform ios --output-dir dist-ci",
    "web": "expo start --web",
    "export:web:ci": "expo export --platform web --output-dir dist-web-ci"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "expo": "^58.0.26",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@types/react": "^19.1.0",
    "typescript": "~6.0.3"
  },
  "type": "module"
}
